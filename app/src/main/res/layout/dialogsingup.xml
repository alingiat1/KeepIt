<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFF0F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- כותרת החלון -->

        <!-- שדה: שם משתמש -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="חלון קופץ - הרשמה"
            android:textColor="#E91E63"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dialogUsernameInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_background"
            android:hint="שם משתמש"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColorHint="#9E9E9E" />

        <!-- שדה: אימייל -->
        <EditText
            android:id="@+id/dialogEmailInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_background"
            android:hint="אימייל"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColorHint="#9E9E9E" />

        <!-- שדה: סיסמה -->
        <EditText
            android:id="@+id/dialogPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/edittext_background"
            android:hint="סיסמה"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColorHint="#9E9E9E" />

        <!-- שדה: אימות סיסמה -->
        <EditText
            android:id="@+id/dialogConfirmPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/edittext_background"
            android:hint="אימות סיסמה"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColorHint="#9E9E9E" />

        <!-- כפתור הרשמה בחלון -->
        <Button
            android:id="@+id/dialogRegisterButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/pink_button"
            android:backgroundTint="#E91E63"
            android:text="הרשמה"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>