<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FA"
    tools:context=".MainActivity">

    <!-- תמונת הרקע העננית -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/login_clouds"
        android:contentDescription="@null" />

    <!-- כרטיס התחברות שקוף ורך -->
    <androidx.cardview.widget.CardView
        android:id="@+id/loginCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="155dp"
        app:cardBackgroundColor="#00FFFFFF"
        app:cardCornerRadius="26dp"
        app:cardElevation="5dp"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layoutDirection="rtl"
            android:background="@drawable/login_card_glass"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="19dp"
            android:paddingBottom="19dp">

            <!-- ברוכה הבאה -->
            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ברוכה הבאה ♡"
                android:textColor="#A65372"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <!-- משפט קצר -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="כל הדברים שאת אוהבת, במקום אחד"
                android:textColor="#B88A9B"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <!-- אימייל -->
            <EditText
                android:id="@+id/usernameInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/login_input_background"
                android:hint="אימייל"
                android:inputType="textEmailAddress"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textAlignment="viewStart"
                android:textColor="#654653"
                android:textColorHint="#B89AA7"
                android:textSize="14sp"
                android:singleLine="true" />

            <!-- סיסמה -->
            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/login_input_background"
                android:hint="סיסמה"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textAlignment="viewStart"
                android:textColor="#654653"
                android:textColorHint="#B89AA7"
                android:textSize="14sp"
                android:singleLine="true" />

            <!-- כפתור התחברות -->
            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/login_primary_button"
                android:backgroundTint="@null"
                android:text="התחברות"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null" />

            <!-- טקסט הרשמה -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="עדיין אין לך חשבון?"
                android:textColor="#A77B8D"
                android:textSize="13sp" />

            <!-- כפתור הרשמה -->
            <Button
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:background="@drawable/register_button"
                android:backgroundTint="@null"
                android:text="הרשמה"
                android:textColor="#B64F78"
                android:textSize="14sp"
                android:textStyle="bold"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>
