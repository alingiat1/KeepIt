<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- סרגל עליון -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#D81B60"
                    android:contentDescription="חזרה" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="הוספת פריט"
                android:textColor="#D81B60"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <View android:layout_width="48dp" android:layout_height="48dp"/>
        </LinearLayout>

        <!-- אזור הוספת תמונה (עם ה-id החשוב cardSelectImage) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSelectImage"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFE4EC"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#D81B60" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="הוסף תמונה / צילום מסך"
                    android:textColor="#D81B60"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- כותרת -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="כותרת"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#FFFFFF"
            android:hint="לדוגמה: מתכון לעוגה"
            android:textColor="#333333"
            android:textColorHint="#B0BEC5"
            android:textSize="15sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp"
            android:elevation="1dp" />

        <!-- קטגוריה -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="קטגוריה"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:elevation="1dp" />

        <!-- מחיר -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="מחיר (אופציונלי)"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etPrice"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#FFFFFF"
            android:hint="₪ 0"
            android:inputType="numberDecimal"
            android:textColor="#333333"
            android:textColorHint="#B0BEC5"
            android:textSize="15sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp"
            android:elevation="1dp" />

        <!-- קישור -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="קישור (אופציונלי)"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etLink"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#FFFFFF"
            android:hint="https://"
            android:inputType="textUri"
            android:textColor="#333333"
            android:textColorHint="#B0BEC5"
            android:textSize="15sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="12dp"
            android:elevation="1dp" />

        <!-- הערה אישית -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="הערה אישית (אופציונלי)"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#FFFFFF"
            android:hint="כתוב כאן..."
            android:gravity="top|start"
            android:textColor="#333333"
            android:textColorHint="#B0BEC5"
            android:textSize="15sp"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:elevation="1dp" />

        <!-- כרטיס תזכורת -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardReminder"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_lock_idle_alarm"
                    app:tint="#D81B60" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="תזכורת (אופציונלי)"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReminderTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="בחר תאריך ושעה"
                        android:textColor="#B0BEC5"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- כפתור שמירה -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#D81B60"
            android:text="שמירה"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>
</ScrollView>